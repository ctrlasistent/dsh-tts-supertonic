{
  "name": "dsh-tts-supertonic",
  "description": "Local Supertonic text-to-speech plugin for deepseek-harness. Automatically reads assistant replies aloud. No cloud services or API keys required.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "runtime",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": ["linux", "win32", "darwin"]
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": ["dsh","dsh-plugin", "deepseek-harness","tts","text-to-speech","supertonic","onnx","local","croatian"]
}